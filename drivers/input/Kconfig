menuconfig INPUT_AZOTEQ_IQS5XX
    bool "Azoteq IQS5xx trackpads"
    default y
    depends on GPIO
    depends on I2C
    depends on INPUT
    depends on DT_HAS_AZOTEQ_IQS5XX_ENABLED
    help
      Enable driver for Azoteq IQS5xx trackpads (mode Windows Precision Touchpad).

if INPUT_AZOTEQ_IQS5XX

config INPUT_AZOTEQ_IQS5XX_INIT_PRIORITY
    int "Azoteq IQS5xx initialization priority"
    default INPUT_INIT_PRIORITY
    help
      Driver initialization priority for the IQS5xx driver.
      Lower values initialize earlier.

endif # INPUT_AZOTEQ_IQS5XX

menuconfig ANALOG_INPUT
    bool "Entree analogique (joystick) sur ADC"
    depends on INPUT
    select ADC
    help
      Lit des canaux ADC et emet leur deflexion comme evenements d'entree.

if ANALOG_INPUT

config ANALOG_INPUT_WORKQUEUE_PRIORITY
    int "Priorite de la workqueue d'echantillonnage"
    default 10

config ANALOG_INPUT_WORKQUEUE_STACK_SIZE
    int "Taille de pile de la workqueue d'echantillonnage"
    default 1024

module = ANALOG_INPUT
module-str = ANALOG_INPUT
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # ANALOG_INPUT

config ZMK_JOYSTICK_ARROWS
    bool "Joystick vers touches flechees"
    default y
    depends on INPUT
    depends on DT_HAS_ZMK_JOYSTICK_ARROWS_ENABLED
    help
      Transforme les axes d'un joystick analogique en appuis sur les fleches.

config ZMK_INPUT_ACTIVITY
    bool "Les evenements d'entree comptent comme activite ZMK"
    default y
    depends on INPUT
    help
      Empeche la mise en veille profonde pendant l'utilisation du pave tactile
      ou du joystick.

config ZMK_BEHAVIOR_PTP_BUTTON
    bool "Behavior &ptp_btn : clics dans le rapport Precision Touchpad"
    default y
    depends on ZMK_TRACKPAD
    depends on DT_HAS_ZMK_BEHAVIOR_PTP_BUTTON_ENABLED
