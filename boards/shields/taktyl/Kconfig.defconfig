if SHIELD_TAKTYL_RIGHT

config ZMK_KEYBOARD_NAME
    default "TakTyl"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

if ZMK_TRACKPAD

# Valeurs logiques = resolution programmee dans l'IQS5xx
# (resolution_x / resolution_y dans taktyl.dtsi).
config ZMK_TRACKPAD_LOGICAL_X
	default 1920

config ZMK_TRACKPAD_LOGICAL_Y
	default 1200

# Taille physique de la zone active, en 0,1 mm
# (le descripteur HID declare des cm avec un exposant -2).
# TPS65 : ~65 x 49 mm, a mesurer sur ton module.
config ZMK_TRACKPAD_PHYSICAL_X
	default 650

config ZMK_TRACKPAD_PHYSICAL_Y
	default 490

endif # ZMK_TRACKPAD

endif 

if SHIELD_TAKTYL_LEFT || SHIELD_TAKTYL_RIGHT

config ZMK_SPLIT
	default y

endif
