#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1)                 RC(3,4) RC(3,5)  RC(3,6)                         RC(3,10) RC(3,11)
        >;
    };
    
    trackpad_listener: trackpad_listener {
		compatible = "zmk,input-listener";
        status = "disabled";
        mode = "trackpad";
		device = <&trackpad>;
    };    

    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

&pro_micro_i2c {
	status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

	trackpad: iqs5xx@74 {
        status = "disabled";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        /* Mode PTP : pas de gestes materiels (tap, scroll, zoom).
         * Windows interprete lui-meme les doigts. */
        palm_rejection;
        max_touch_number = <5>;

        /* Doit rester identique a CONFIG_ZMK_TRACKPAD_LOGICAL_X / _Y
         * (Kconfig.defconfig). */

		resolution_x = <1920>;
  		resolution_y = <1200>;

        /* 8 ms = 125 Hz, minimum demande par Windows pour un PTP. */
        report_rate_active_mode = <6>;

        bottom-beta = <5>;
        stationary-threshold = <5>;

        switch-xy;

        reset-gpios = <&pro_micro 18 GPIO_ACTIVE_LOW>; /* P0.10 */
        rdy-gpios = <&pro_micro 19 GPIO_ACTIVE_HIGH>; /* P1.11 */
    };
};
