#include "taktyl.dtsi"

&default_transform { // Offset of 3 because the left side has 3 columns
    col-offset = <6>;
};
&kscankeys {
    col-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>,
                <&pro_micro 5 GPIO_ACTIVE_HIGH>,
                <&pro_micro 6 GPIO_ACTIVE_HIGH>,
                <&pro_micro 7 GPIO_ACTIVE_HIGH>,
                <&pro_micro 8 GPIO_ACTIVE_HIGH>,
                <&pro_micro 9 GPIO_ACTIVE_HIGH>;
};

/ {
	kscanjoystick: kscan_joystick {
        compatible = "zmk,kscan-joystick";
        poll-period-ms = <10>;  /* 10Hz */
        idle-period-ms = <50>; /* 20Hz */
        angle-overlap = <30>;
        /* do not use a second threshold with bad quality joysticks */
        /* thresholds = [0A 78]; */
        status = "okay";
        wakeup-source;
        io-channels = <&adc 7>, <&adc 5>;
        io-channel-names = "x-axis", "y-axis";
	};
};



&adc {
	status = "okay";
};

&joystick_listener {
    status = "okay";
    device = <&anin0>;
};
