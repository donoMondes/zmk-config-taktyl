#include "taktyl.dtsi"
#include <dt-bindings/input/input-event-codes.h> 

&default_transform { // Offset of 3 because the left side has 3 columns
    col-offset = <6>;
};
&kscan0 {
    col-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>,
                <&pro_micro 5 GPIO_ACTIVE_HIGH>,
                <&pro_micro 6 GPIO_ACTIVE_HIGH>,
                <&pro_micro 7 GPIO_ACTIVE_HIGH>,
                <&pro_micro 8 GPIO_ACTIVE_HIGH>,
                <&pro_micro 9 GPIO_ACTIVE_HIGH>;
};

&adc {
	status = "okay";
};

/ {
	anin0: analog_input_0 {
		compatible = "zmk,analog-input";
		sampling-hz = <50>;
		x-ch {
			io-channels = <&adc 7>; // <--- see ain-map.png for nRF52840
			mv-mid = <1770>;
			mv-min-max = <1600>;
			mv-deadzone = <20>;
			scale-multiplier = <1>;
			scale-divisor = <20
			evt-type = <INPUT_EV_REL>;
			input-code = <INPUT_REL_Y>;
		};
		y-ch {
			io-channels = <&adc 5>; // <--- see ain-map.png for nRF52840
			mv-mid = <1630>;
			mv-min-max = <1600>;
			mv-deadzone = <20>;
			scale-multiplier = <1>;
			scale-divisor = <200>;
			// invert;
			evt-type = <INPUT_EV_REL>;
			input-code = <INPUT_REL_X>;

			/* enable report mdoe for gamepad axix or knob */
			/* to only call input_report on quantquantized value is updated */
			/* NOTE: mouse input does NOT need this */
			// report-on-change-only;

		};
	};
};

/ {
    joystick_listener {
        compatible = "zmk,input-listener";
        device = <&anin0>;
    };
};